{
  "name": "nemzeti-vpn-tv",
  "version": "0.1.4",
  "private": true,
  "description": "An independent NVT live TV client for LG webOS",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && node dist/dev/server.cjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.cjs",
    "test:ui": "playwright test",
    "package:tv": "npm run build && ares-package dist/tv dist/service -o dist/packages",
    "check": "npm run typecheck && npm test && npm run test:ui",
    "probe:login": "npm run build && node dist/tools/probe.cjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22.0.0",
    "@types/tough-cookie": "^4.0.5",
    "@webos-tools/cli": "3.2.6",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "hls.js": "1.7.3",
    "htmlparser2": "^9.1.0",
    "tough-cookie": "4.1.4"
  }
}
